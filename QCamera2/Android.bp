soong_config_string_variable {
    name: "target_device",
    values: [
        "clover",
        "lavender",
        "platina",
    ],
}

soong_config_module_type {
    name: "camera_hal_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "qcomcamera",
    variables: ["target_device"],
    properties: [
        "cflags",
        "shared_libs",
    ],
}

camera_hal_cc_defaults {
    name: "camera_hal_defaults",
    cflags: [
        "-Wno-unused-but-set-variable",
    ],
    soong_config_variables: {
        target_device: {
            clover: {
                cflags: ["-DTARGET_DEVICE_CLOVER"],
                shared_libs: [
                    "//vendor/xiaomi/clover:libts_face_beautify_hal",
                    "//vendor/xiaomi/clover:libts_detected_face_hal",
                ],
            },
            lavender: {
                cflags: ["-DTARGET_DEVICE_LAVENDER"],
                shared_libs: [
                    "//vendor/xiaomi/lavender:libts_face_beautify_hal",
                    "//vendor/xiaomi/lavender:libts_detected_face_hal",
                ],
            },
            platina: {
                cflags: ["-DTARGET_DEVICE_PLATINA"],
            },
        },
    },
}

cc_library_shared { 
    name: "camera.sdm660", 
    compile_multilib: "32", 
    defaults: ["camera_hal_defaults"],
    cflags: [ 
        "-Wall", 
        "-Wextra", 
        "-Werror", 
        "-Wno-compound-token-split-by-macro", 
        "-DFDLEAK_FLAG", 
        "-DMEMLEAK_FLAG", 
        "-DQCAMERA_HAL1_SUPPORT", 
        "-DSYSTEM_HEADER_PREFIX=sys", 
        "-DHAS_MULTIMEDIA_HINTS", 
        "-D_ANDROID", 
        "-DUSE_HAL_3_5", 
        "-DVANILLA_HAL", 
        "-std=c++14", 
        "-std=gnu++1z", 
        "-DUSE_VENDOR_PROP", 
        "-DDEFAULT_DENOISE_MODE_ON", 
        "-DHAL3", 
        "-DQCAMERA_REDEFINE_LOG", 
        "-DTARGET_TS_MAKEUP", 
        "-DVENUS_PRESENT", 
        "-DUBWC_PRESENT", 
        "-DUSE_CAMERA_METABUFFER_UTILS", 
        "-DVIDEO_EXPLICIT_UBWC", 
        "-DSUPPORT_ONLY_HAL3", 
        "-DSUPPORT_POWER_HINT_XML", 
    ], 
    include_dirs: [ 
        "hardware/qcom-caf/sdm660/camera/mm-image-codec/qexif", 
        "hardware/qcom-caf/sdm660/camera/mm-image-codec/qomx_core", 
        "frameworks/native/include", 
        "hardware/qcom-caf/sdm660/media/libstagefrighthw", 
        "hardware/qcom-caf/sdm660/media/mm-core/inc", 
        "system/memory/libion/kernel-headers", 
        "system/memory/libion/include", 
        "hardware/qcom-caf/sdm660/display/libqservice", 
    ], 
    local_include_dirs: [ 
        "stack/common/leak", 
        "stack/mm-camera-interface/inc", 
        "util", 
        "HAL3", 
        "HAL", 
        "HAL/tsMakeuplib/include", 
    ], 
    header_libs: [ 
        "camera_common_headers", 
        "media_plugin_headers", 
        "libandroid_sensor_headers", 
        "libcutils_headers", 
        "libsystem_headers", 
        "libgui_headers", 
        "libhardware_headers", 
        "display_headers", 
        "generated_kernel_headers", 
    ], 
    ldflags: [ 
        "-Wl,--wrap=open", 
        "-Wl,--wrap=close", 
        "-Wl,--wrap=socket", 
        "-Wl,--wrap=pipe", 
        "-Wl,--wrap=mmap", 
        "-Wl,--wrap=__open_2", 
        "-Wl,--wrap=malloc", 
        "-Wl,--wrap=free", 
        "-Wl,--wrap=realloc", 
        "-Wl,--wrap=calloc", 
    ], 
 
    relative_install_path: "hw",
 
    shared_libs: [
        "liblog",
        "libhardware",
        "libutils",
        "libcutils",
        "libdl",
        "libsync",
        "libmmcamera_interface",
        "libmmjpeg_interface",
        "libui",
        "libcamera_metadata",
        "libqdMetaData",
        "libqservice",
        "libbinder",
        "libbase",
        "libcutils",
        "libdl",
        "libhal_dbg",
        "libion",
        "libhidlbase",
        "libgui",
    ],
    srcs: [
        "util/QCameraBufferMaps.cpp",
        "util/QCameraCmdThread.cpp",
        "util/QCameraFlash.cpp",
        "util/QCameraPerf.cpp",
        "util/QCameraQueue.cpp",
        "util/QCameraDisplay.cpp",
        "util/QCameraCommon.cpp",
        "util/QCameraTrace.cpp",
        "util/camscope_packet_type.cpp",
        "util/QCameraPerfTranslator.cpp",
        "QCamera2Hal.cpp",
        "QCamera2Factory.cpp",
        "HAL3/QCamera3HWI.cpp",
        "HAL3/QCamera3Mem.cpp",
        "HAL3/QCamera3Stream.cpp",
        "HAL3/QCamera3Channel.cpp",
        "HAL3/QCamera3VendorTags.cpp",
        "HAL3/QCamera3PostProc.cpp",
        "HAL3/QCamera3CropRegionMapper.cpp",
        "HAL3/QCamera3StreamMem.cpp",
        "HAL/QCamera2HWI.cpp",
        "HAL/QCameraMuxer.cpp",
        "HAL/QCameraMem.cpp",
        "HAL/QCameraStateMachine.cpp",
        "HAL/QCameraChannel.cpp",
        "HAL/QCameraStream.cpp",
        "HAL/QCameraPostProc.cpp",
        "HAL/QCamera2HWICallbacks.cpp",
        "HAL/QCameraParameters.cpp",
        "HAL/CameraParameters.cpp",
        "HAL/QCameraParametersIntf.cpp",
        "HAL/QCameraThermalAdapter.cpp",
        "util/QCameraFOVControl.cpp",
        "util/QCameraHALPP.cpp",
        "util/QCameraDualFOVPP.cpp",
        "util/QCameraExtZoomTranslator.cpp",
        "util/QCameraPprocManager.cpp",
        "util/QCameraBokeh.cpp",
        "util/QCameraClearSight.cpp",
    ],
    static_libs: ["android.hardware.camera.common@1.0-helper"],

    vendor: true,
}

cc_library_headers {
    name: "camera_common_headers",
    installable: false,
    export_include_dirs: ["stack/common"],

}
